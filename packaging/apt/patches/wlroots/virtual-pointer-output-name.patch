Description: Remember a virtual pointer's output as its output_name
 A virtual pointer made with an output is mapped to it once, on creation,
 through the new_virtual_pointer event's suggested_output. labwc maps every
 pointer again on each layout change and reconfigure, to the output its
 output_name names, and a virtual pointer has none, so it is unmapped and its
 absolute motion spans the whole layout from then on: once there are two
 outputs, every position on either lands somewhere else. Giving it the
 suggested output's name, as the Wayland backend does for its pointers, keeps it
 on that output; Sway, which leaves a pointer with no output_name as it was,
 maps it there by the name all the same.
Author: wlshare
Forwarded: no
Last-Update: 2026-10-17

--- a/types/wlr_virtual_pointer_v1.c
+++ b/types/wlr_virtual_pointer_v1.c
@@ -1,5 +1,6 @@
 #include <assert.h>
 #include <stdlib.h>
+#include <string.h>
 #include <wlr/interfaces/wlr_pointer.h>
 #include <wlr/types/wlr_seat.h>
 #include <wlr/types/wlr_virtual_pointer_v1.h>
@@ -267,6 +268,11 @@
 	if (output) {
 		struct wlr_output *wlr_output = wlr_output_from_resource(output);
 		event.suggested_output = wlr_output;
+		// What a compositor maps the pointer back to whenever it maps its
+		// pointers again, as it does a backend pointer to its output.
+		if (wlr_output != NULL) {
+			virtual_pointer->pointer.output_name = strdup(wlr_output->name);
+		}
 	}
 
 	virtual_pointer->resource = pointer_resource;
